generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  picture   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  jobs      EmailJob[]
}

model EmailJob {
  id          String      @id @default(cuid())
  recipient   String
  subject     String
  body        String
  scheduledAt DateTime
  status      EmailStatus @default(SCHEDULED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
}

enum EmailStatus {
  SCHEDULED
  SENT
  FAILED
}
